# BizSuite local environment — copy to .env and fill in real values.
# .env is gitignored; never commit real credentials.

# PostgreSQL — EITHER a full connection URL (takes precedence; use for Neon/cloud,
# keep sslmode=require in the URL) ...
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ... OR standard PG* vars (used when DATABASE_URL is unset; typical for local dev)
PGHOST=localhost
PGPORT=5432
PGDATABASE=bizsuite
PGUSER=postgres
PGPASSWORD=your-postgres-password-here

# API
PORT=3000
NODE_ENV=development


# Dev-only login bypass. When true (and NODE_ENV is not "production"), the API
# skips session checks and runs every request as DEV_AUTH_EMAIL, so the SPA
# opens already logged in. The user row is created on first use if missing.
# The server REFUSES TO START if this is true while NODE_ENV=production.
DEV_AUTH_BYPASS=false
DEV_AUTH_EMAIL=dev@localhost
DEV_AUTH_ROLE=admin

# BizSuite local environment — copy to .env and fill in real values.
# .env is gitignored; never commit real credentials.

# PostgreSQL connection (standard PG* vars, read by src/shared/db.ts and psql alike)
PGHOST=localhost
PGPORT=5432
PGDATABASE=bizsuite
PGUSER=postgres
PGPASSWORD=your-postgres-password-here

# API
PORT=3000
NODE_ENV=development
